-lib heaps
-lib castle
-lib hxbit
-lib domkit
--macro include('h3d')
--macro include('h2d',true,['h2d.domkit.InitComponents'])
--macro include('hxsl',true,['hxsl.Macros','hxsl.CacheFileBuilder','hxsl.Checker'])
--macro include('hxd',true,['hxd.res.FileTree','hxd.impl.BitsBuilder','hxd.fmt.pak.Build','hxd.snd.openal','hxd.res.Config'])
-D doc-gen
-D resourcesPath=docs/api/res
--no-output
-js heaps.js
-xml docs/api/heaps_js.xml
